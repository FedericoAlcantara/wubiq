<project name="wubiq-client" basedir="." default="create-client-jar">

	<property name="project" value="wubiq-client" />
	<property name="dist" value="${basedir}/dist" />
	<property name="src" value="${basedir}/src" />
	<property name="i18n" value="${basedir}/i18n" />
	<property name="bin" value="${basedir}/bin" />
	<property name="lib" value="${basedir}/lib" />
	<property name="lib-nondeploy" value="${basedir}/lib-nondeploy" />
	<property name="output.jar" value="${dist}/${project}" />
	<property name="jar.build" value="${basedir}/dist/build" />
	<property name="workspace.dir" value="${basedir}/.." />
	<property name="basedir.common" value="${workspace.dir}/wubiq-common" />
	<property name="basedir.gradle" value="${workspace.dir}/wubiq-android-gradle" />
	<!-- Packages the client reaches by reflection; Java 9+ opens them when the jar runs with -jar, older JDKs ignore it. -->
	<property name="client.add.opens" value="java.base/java.lang java.desktop/javax.print java.desktop/sun.print" />
	
	<path id="project.classpath">
		<pathelement path="${lib}"/>
		<pathelement path="${bin}"/>
		<fileset dir="${lib}"> 
			<include name="**/*.jar"/> 
		</fileset> 
		<fileset dir="${basedir.common}/bin" />
		<fileset dir="${basedir.common}/lib">
			<include name="**/*.jar"/> 
		</fileset>
	</path>
	
	<path id="project.src">
		<pathelement path="${src}"/>
	</path>	
	
	<target name="create-client-jar" depends="clean">
		<available file="${basedir.common}" property="wubiq-common-exists" />

		<antcall target="create-common-jar" />
		
		<javac destdir="${bin}" nowarn="true" failonerror="true" errorproperty="builds.failed"
				debug="true" target="1.6" source="1.6"> 
			<src refid="project.src"/>
			<classpath refid="project.classpath" /> 
		</javac>
		
		<antcall target="create-client-jar-build" />

		<delete file="${lib}/wubiq-common.jar"/>

		<jar jarfile="${output.jar}.jar">
			<fileset dir="${jar.build}" />
			<manifest>
				<attribute name="Main-Class" value="net.sf.wubiq.clients.LocalPrintManager"/>	
				<attribute name="Add-Opens" value="${client.add.opens}"/>
			</manifest>		
		</jar>
		<copy todir="${basedir.gradle}/app/libs/" file="${output.jar}.jar"/>
	</target>
	
	<target name="create-common-jar" if="wubiq-common-exists">
		<ant antfile="${basedir.common}/build.xml" dir="${basedir.common}" target="create-common-jar" 
				inheritall="false" inheritrefs="false"/>
		<copy file="${basedir.common}/dist/wubiq-common.jar" todir="${lib}" />
	</target>
	
	<target name="create-client-jar-build">
		<unjar dest="${jar.build}">
			<fileset dir="${lib}" includes="*.jar" />
		</unjar>
		<copy todir="${jar.build}" >
			<fileset dir="${bin}" includes = "**/*" />
		</copy>
		<copy todir="${jar.build}" >
			<fileset dir="${i18n}" includes = "**/*" />
		</copy>
	</target>

	<property name="witness.dir" value="${workspace.dir}/wubiq-dotmatrix-witness" />
	<property name="testBin" value="${basedir}/build-tests/classes" />

	<path id="common.classpath">
		<fileset dir="${basedir.common}/lib">
			<include name="**/*.jar"/>
		</fileset>
		<fileset dir="${basedir.common}/lib-nondeploy">
			<include name="**/*.jar"/>
		</fileset>
	</path>

	<path id="test.classpath">
		<pathelement path="${bin}"/>
		<pathelement path="${i18n}"/>
		<pathelement path="${basedir.common}/bin"/>
		<pathelement path="${basedir.common}/i18n"/>
		<fileset dir="${lib}">
			<include name="**/*.jar"/>
			<exclude name="wubiq-common.jar"/>
		</fileset>
		<path refid="common.classpath" />
		<pathelement path="${witness.dir}/bin"/>
		<pathelement path="${testBin}"/>
		<fileset dir="${witness.dir}/lib-test">
			<include name="**/*.jar"/>
		</fileset>
	</path>

	<target name="compile" description="Compiles wubiq-common and the client sources without packaging">
		<mkdir dir="${basedir.common}/bin"/>
		<javac srcdir="${basedir.common}/src" destdir="${basedir.common}/bin" nowarn="true" failonerror="true"
				includeantruntime="false" debug="true" target="1.6" source="1.6">
			<classpath refid="common.classpath" />
		</javac>
		<mkdir dir="${bin}"/>
		<javac destdir="${bin}" nowarn="true" failonerror="true" includeantruntime="false"
				debug="true" target="1.6" source="1.6">
			<src refid="project.src"/>
			<classpath refid="test.classpath" />
		</javac>
	</target>

	<target name="compile-tests" depends="compile">
		<ant dir="${witness.dir}" target="compile" inheritAll="false" />
		<mkdir dir="${testBin}"/>
		<javac srcdir="${basedir}/tests-src" destdir="${testBin}" nowarn="true" failonerror="true"
				includeantruntime="false" debug="true" target="1.6" source="1.6" encoding="UTF-8">
			<classpath refid="test.classpath" />
		</javac>
	</target>

	<path id="launcher.classpath">
		<pathelement path="${bin}"/>
		<pathelement path="${i18n}"/>
		<pathelement path="${basedir.common}/bin"/>
		<pathelement path="${basedir.common}/i18n"/>
		<fileset dir="${lib}">
			<include name="**/*.jar"/>
			<exclude name="wubiq-common.jar"/>
		</fileset>
		<path refid="common.classpath" />
	</path>

	<target name="create-launcher-jar" depends="compile"
			description="Writes build-tests/wubiq-client-launcher.jar: runs the compiled client with -jar and the manifest of the client jar">
		<mkdir dir="${basedir}/build-tests"/>
		<manifestclasspath property="launcher.manifest.classpath" jarfile="${basedir}/build-tests/wubiq-client-launcher.jar">
			<classpath refid="launcher.classpath" />
		</manifestclasspath>
		<jar jarfile="${basedir}/build-tests/wubiq-client-launcher.jar">
			<manifest>
				<attribute name="Main-Class" value="net.sf.wubiq.clients.LocalPrintManager"/>
				<attribute name="Add-Opens" value="${client.add.opens}"/>
				<attribute name="Class-Path" value="${launcher.manifest.classpath}"/>
			</manifest>
		</jar>
	</target>

	<target name="test-dotmatrix" depends="compile-tests"
			description="Prints the dot-matrix fixtures into the virtual printer and writes build-tests/dotmatrix-report">
		<java classname="org.junit.runner.JUnitCore" fork="true" failonerror="true" dir="${basedir}">
			<classpath refid="test.classpath" />
			<sysproperty key="java.awt.headless" value="true" />
			<syspropertyset>
				<propertyref prefix="wubiq.dotmatrix."/>
			</syspropertyset>
			<arg value="net.sf.wubiq.dotmatrix.ReferenceEncoderTest" />
			<arg value="net.sf.wubiq.dotmatrix.DotMatrixWitnessTest" />
		</java>
	</target>

	<target name="create-javadoc-documentation" description="Creates javadoc documentation">
		<echo message="Creating wubiq-client javadoc" />
		<delete dir="${basedir}/javadoc" failonerror="false" />
		<javadoc destdir="${basedir}/javadoc" sourcepath="${basedir}/src" packagenames="net.sf.wubiq.*"
				classpathref="project.classpath" failonerror="false" use="true" windowtitle="Wubiq Client Javadoc"
				doctitle="Wubiq Client API Documentation" />
	</target>

	<target name="clean">
		<delete dir="${dist}" failonerror="false" />
		<delete dir="${bin}" failonerror="false" />
		<delete dir="${jar.build}" failonerror="false" />

		<mkdir dir="${dist}"/>
		<mkdir dir="${bin}"/>
		<mkdir dir="${jar.build}"/>
	</target>
</project>
