<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Wubiq.Screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/versionLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                style="@style/Wubiq.Title"
                android:layout_marginBottom="4dp"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textAppearance="?android:attr/textAppearanceSmall" />

        </LinearLayout>

        <Button
            android:id="@+id/configureServer"
            style="@style/Wubiq.Button"
            android:onClick="configureServer"
            android:text="@string/configure_server" />

        <Button
            android:id="@+id/configureBluetooth"
            style="@style/Wubiq.Button"
            android:onClick="configureBluetooth"
            android:text="@string/configure_bluetooth" />

        <Button
            android:id="@+id/advancedConfiguration"
            style="@style/Wubiq.Button"
            android:onClick="advancedConfiguration"
            android:text="@string/advanced_configuration" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <Button
            android:id="@+id/startServiceButton"
            style="@style/Wubiq.Button"
            android:backgroundTint="#437649"
            android:onClick="startService"
            android:text="@string/start_service"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/stopServiceButton"
            style="@style/Wubiq.Button"
            android:backgroundTint="#845792"
            android:onClick="stopService"
            android:text="@string/stop_service"
            android:textColor="@color/white" />

    </LinearLayout>

</ScrollView>
