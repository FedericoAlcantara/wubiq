{
  "permissions": {
    "allow": [
      "Skill(address-pr-review)",
      "Skill(code-issue)",
      "Skill(do-pr)",
      "Skill(gate)",
      "Skill(gate-commit)",
      "Skill(gate-fix)",
      "Skill(improve-issue)",
      "Skill(merge-pr)",
      "Skill(orchestrate-issue)",
      "Skill(pr-from-issue)",
      "Skill(review-issue)",
      "Skill(spec-load)",
      "Skill(spec-store)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "if [ \"$(git branch --show-current)\" = \"master\" ]; then echo 'WARNING: on master - create a feature branch before committing'; fi" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-long-commands.sh" }
        ]
      }
    ]
  }
}
